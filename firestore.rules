rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /appDirectory/{appId} {
      // Authorize ownership here; validate public metadata in application code.
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && appId == request.resource.data.appId;
      allow update: if request.auth != null && request.auth.uid == resource.data.ownerUid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.appId == resource.data.appId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }
    match /users/{userId}/apps/{appId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    // Paths outside appDirectory/{appId} and users/{userId}/apps/{appId}/...
    // are denied by default.
  }
}
